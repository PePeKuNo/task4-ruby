<% content_for :title, "Chat" %>

<div class="row">
  <%# Chat Area - Main chat panel %>
  <div class="col-lg-8">
    <div class="card shadow-sm h-100 d-flex flex-column">
      <div class="card-header bg-white border-bottom">
        <h5 class="mb-0 fw-bold">Chat Area</h5>
      </div>
      <div class="card-body flex-fill d-flex flex-column overflow-hidden">
        <%# Messages container %>
        <div class="flex-fill overflow-auto mb-3" id="chat-messages" style="max-height: 400px;">
          <% if @chat_messages.any? %>
            <% @chat_messages.each do |message| %>
              <div class="mb-3 <%= 'text-end' if message.user_id == current_user.id %>">
                <div class="d-inline-block max-w-75 p-3 rounded-3 <%= message.user_id == current_user.id ? 'bg-primary text-white' : 'bg-light' %>">
                  <div class="small text-muted mb-1 <%= message.user_id == current_user.id ? 'text-white-50' : '' %>">
                    <%= message.user.full_name %> • <%= message.created_at.strftime('%H:%M') %>
                  </div>
                  <div class="<%= message.user_id == current_user.id ? 'text-white' : 'text-dark' %>">
                    <%= message.content %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-4">
              <i class="bi bi-chat-dots display-1"></i>
              <p class="mt-2">No messages yet. Start the conversation!</p>
            </div>
          <% end %>
        </div>

        <%# Message form - the form element itself has id="chat_form" (see chat/_form) %>
        <div class="mt-2">
          <%= render 'chat/form', chat_message: @chat_message %>
        </div>
      </div>
    </div>
  </div>

  <%# Online Users Sidebar %>
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white border-bottom">
        <h5 class="mb-0 fw-bold">Online Users</h5>
      </div>
      <div class="card-body overflow-auto" style="max-height: 500px;">
        <ul class="list-group list-group-flush">
          <% User.active.ordered_by_last_seen.each do |user| %>
            <li class="list-group-item d-flex align-items-center px-3 py-2">
              <div class="flex-shrink-0">
                <span class="badge rounded-pill <%= user.id == current_user.id ? 'bg-primary' : 'bg-success' %>">
                  <%= user.id == current_user.id ? 'You' : 'Online' %>
                </span>
              </div>
              <div class="flex-fill ms-3 text-truncate">
                <div class="fw-medium"><%= user.full_name %></div>
                <small class="text-muted"><%= user.job_position %></small>
              </div>
              <small class="text-muted"><%= user.last_seen&.strftime('%H:%M') || 'Never' %></small>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%# IMPORTANT: AI Assistant row - Parts 2 and 3 %>
<%# NOTE: One Stimulus controller ("assistant") powers both cards below %>
<%# NOTA BENE: Questions go to the real POST /ai/chat endpoint, tool calls to POST /ai/tools %>
<div class="row mt-4" data-controller="assistant">
  <div class="col-lg-8">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white border-bottom">
        <h5 class="mb-0 fw-bold"><i class="bi bi-robot me-2"></i>AI Assistant - ask about the database (Part 2)</h5>
      </div>
      <div class="card-body">
        <div class="input-group mb-2">
          <input type="text" class="form-control" data-assistant-target="question"
                 placeholder="Example: How many users are there?" aria-label="Question for the AI">
          <button class="btn btn-primary" type="button" data-action="assistant#ask">Ask AI</button>
        </div>
        <div class="mb-2">
          <%# NOTE: Suggested questions - one click sends the question to the AI %>
          <% ['How many users are there?', 'Show blocked users', 'Show active users'].each do |question| %>
            <button type="button" class="btn btn-outline-secondary btn-sm me-1 mb-1"
                    data-action="assistant#ask"
                    data-assistant-question-value="<%= question %>"><%= question %></button>
          <% end %>
        </div>
        <div class="border rounded p-3 bg-light min-height-3rem" data-assistant-target="answer">
          <span class="text-muted">The AI answer will appear here. It is generated from real database queries.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white border-bottom">
        <h5 class="mb-0 fw-bold"><i class="bi bi-funnel me-2"></i>AI Tool: filter users (Part 3)</h5>
      </div>
      <div class="card-body">
        <div class="input-group mb-2">
          <select class="form-select" data-assistant-target="statusFilter" aria-label="Status filter for the AI tool">
            <option value="">All statuses</option>
            <option value="active">Active</option>
            <option value="blocked">Blocked</option>
          </select>
          <button class="btn btn-primary" type="button" data-action="assistant#filter">Run tool</button>
        </div>
        <div data-assistant-target="filterResult">
          <span class="text-muted small">The AI tool result will appear here (first 10 rows).</span>
        </div>
      </div>
    </div>
  </div>
</div>

<%# Turbo Stream for real-time message updates %>
<%= turbo_stream_from 'chat_messages' %>