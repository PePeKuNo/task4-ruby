<%# Turbo Stream response for successful message creation %>
<%= turbo_stream.prepend 'chat-messages' do %>
  <div class="mb-3 text-end">
    <div class="d-inline-block max-w-75 p-3 rounded-3 bg-primary text-white">
      <div class="small text-white-50 mb-1">
        <%= @chat_message.user.full_name %> • <%= @chat_message.created_at.strftime('%H:%M') %>
      </div>
      <div><%= @chat_message.content %></div>
    </div>
  </div>
<% end %>

<%# Replace the form with a fresh one %>
<%= turbo_stream.replace 'chat_form' do %>
  <%= render 'chat/form', chat_message: ChatMessage.new %>
<% end %>