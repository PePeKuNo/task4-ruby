<%= form_with model: chat_message, url: chat_path, class: 'd-flex gap-2', data: { turbo: true } do |form| %>
  <% if chat_message.errors.any? %>
    <div class="alert alert-danger d-flex align-items-center flex-fill" role="alert">
      <ul class="mb-0">
        <% chat_message.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="flex-fill">
      <%= form.text_field :content,
          class: 'form-control',
          placeholder: 'Type your message...',
          maxlength: 1000,
          required: true,
          autocomplete: 'off',
          aria_label: 'Chat message' %>
    </div>
    <%= form.submit 'Send', class: 'btn btn-primary', data: { disable_with: 'Sending...' } %>
  <% end %>
<% end %>